{
  "$defs": {
    "CatalogReq": {
      "additionalProperties": false,
      "description": "A catalog requirement: a member of exactly one outcome.",
      "properties": {
        "id": {
          "description": "`REQ-<n>`, never reused.",
          "pattern": "^REQ-[1-9][0-9]*$",
          "title": "Id",
          "type": "string"
        },
        "statement": {
          "description": "Effect and rationale.",
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        },
        "criteria": {
          "description": "Acceptance criteria.",
          "items": {
            "$ref": "#/$defs/Criterion"
          },
          "minItems": 1,
          "title": "Criteria",
          "type": "array"
        },
        "kind": {
          "description": "Which proof channel binds it (ADR-0.0.59).",
          "enum": [
            "BEHAVIOR",
            "SUPPORT",
            "STRUCTURAL-FENCE"
          ],
          "title": "Kind",
          "type": "string"
        },
        "revision": {
          "description": "Editorial amendments only; never resets proof (RP-12 ruling 31).",
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "supersedes": {
          "anyOf": [
            {
              "pattern": "^REQ-[1-9][0-9]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The REQ this one supersedes, which stays whole.",
          "title": "Supersedes"
        },
        "specialization": {
          "const": "catalog",
          "description": "Which requirement this is.",
          "title": "Specialization",
          "type": "string"
        },
        "member_of": {
          "description": "Its outcome's code.",
          "pattern": "^[A-Z][1-9][0-9]*(\\.[1-9][0-9]*)*$",
          "title": "Member Of",
          "type": "string"
        },
        "derives_from": {
          "description": "PRD FR ids or section 7 attributes.",
          "items": {
            "type": "string"
          },
          "title": "Derives From",
          "type": "array"
        },
        "applies_to": {
          "description": "Targets, for a Q-family NFR only.",
          "items": {
            "type": "string"
          },
          "title": "Applies To",
          "type": "array"
        }
      },
      "required": [
        "id",
        "statement",
        "criteria",
        "kind",
        "revision",
        "specialization",
        "member_of",
        "derives_from",
        "applies_to"
      ],
      "title": "CatalogReq",
      "type": "object"
    },
    "Criterion": {
      "additionalProperties": false,
      "description": "One acceptance criterion, on the `ghi-close` closure-contract precedent.",
      "properties": {
        "state_or_input": {
          "description": "The state or input.",
          "minLength": 1,
          "title": "State Or Input",
          "type": "string"
        },
        "required_outcome": {
          "description": "What must then hold.",
          "minLength": 1,
          "title": "Required Outcome",
          "type": "string"
        },
        "evidence": {
          "description": "The semantic evidence that shows it.",
          "minLength": 1,
          "title": "Evidence",
          "type": "string"
        }
      },
      "required": [
        "state_or_input",
        "required_outcome",
        "evidence"
      ],
      "title": "Criterion",
      "type": "object"
    },
    "RepairReq": {
      "additionalProperties": false,
      "description": "A repair requirement: held on its repair package, naming its problem report.",
      "properties": {
        "id": {
          "description": "`REQ-<n>`, never reused.",
          "pattern": "^REQ-[1-9][0-9]*$",
          "title": "Id",
          "type": "string"
        },
        "statement": {
          "description": "Effect and rationale.",
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        },
        "criteria": {
          "description": "Acceptance criteria.",
          "items": {
            "$ref": "#/$defs/Criterion"
          },
          "minItems": 1,
          "title": "Criteria",
          "type": "array"
        },
        "kind": {
          "description": "Which proof channel binds it (ADR-0.0.59).",
          "enum": [
            "BEHAVIOR",
            "SUPPORT",
            "STRUCTURAL-FENCE"
          ],
          "title": "Kind",
          "type": "string"
        },
        "revision": {
          "description": "Editorial amendments only; never resets proof (RP-12 ruling 31).",
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "supersedes": {
          "anyOf": [
            {
              "pattern": "^REQ-[1-9][0-9]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The REQ this one supersedes, which stays whole.",
          "title": "Supersedes"
        },
        "specialization": {
          "const": "repair",
          "description": "Which requirement this is.",
          "title": "Specialization",
          "type": "string"
        },
        "held_on": {
          "description": "The repair package it is held on.",
          "pattern": "^WP-[0-9]{2,}-[a-z0-9]+(-[a-z0-9]+)*$",
          "title": "Held On",
          "type": "string"
        },
        "problem_report": {
          "description": "The GitHub issue it answers (ruling 9).",
          "minimum": 1,
          "title": "Problem Report",
          "type": "integer"
        },
        "aligns_to": {
          "anyOf": [
            {
              "pattern": "^REQ-[1-9][0-9]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "A catalog REQ of design it aligns to.",
          "title": "Aligns To"
        }
      },
      "required": [
        "id",
        "statement",
        "criteria",
        "kind",
        "revision",
        "specialization",
        "held_on",
        "problem_report"
      ],
      "title": "RepairReq",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "`data/catalog/reqs.json`.",
  "properties": {
    "_doc": {
      "description": "What the file is.",
      "minLength": 1,
      "title": "Doc",
      "type": "string"
    },
    "reqs": {
      "description": "The requirements.",
      "items": {
        "discriminator": {
          "mapping": {
            "catalog": "#/$defs/CatalogReq",
            "repair": "#/$defs/RepairReq"
          },
          "propertyName": "specialization"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/CatalogReq"
          },
          {
            "$ref": "#/$defs/RepairReq"
          }
        ]
      },
      "title": "Reqs",
      "type": "array"
    }
  },
  "required": [
    "_doc",
    "reqs"
  ],
  "title": "ReqsFile",
  "type": "object"
}
