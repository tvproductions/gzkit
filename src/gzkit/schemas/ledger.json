{
  "ledger_schema": "gzkit.ledger.v1",
  "required": ["schema", "event", "id", "ts"],
  "events": {
    "project_init": {
      "required": ["mode"],
      "properties": {
        "mode": { "type": "string", "enum": ["lite", "heavy"] }
      }
    },
    "prd_created": {
      "required": []
    },
    "constitution_created": {
      "required": []
    },
    "obpi_created": {
      "required": ["parent"],
      "properties": {
        "parent": { "type": "string", "min_length": 1 }
      }
    },
    "adr_created": {
      "required": ["lane"],
      "properties": {
        "lane": { "type": "string", "enum": ["lite", "heavy"] },
        "parent": { "type": "string" }
      }
    },
    "artifact_edited": {
      "required": ["path"],
      "properties": {
        "path": { "type": "string", "min_length": 1 },
        "session": { "type": "string", "min_length": 1 }
      }
    },
    "attested": {
      "required": ["status", "by"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["completed", "partial", "dropped"]
        },
        "by": { "type": "string", "min_length": 1 },
        "reason": { "type": "string", "min_length": 1 }
      }
    },
    "gate_checked": {
      "required": ["gate", "status", "command", "returncode"],
      "properties": {
        "gate": { "type": "integer", "min": 1 },
        "status": {
          "type": "string",
          "enum": ["pass", "fail", "pending", "n/a"]
        },
        "command": { "type": "string", "min_length": 1 },
        "returncode": { "type": "integer" },
        "evidence": { "type": "string" }
      }
    },
    "closeout_initiated": {
      "required": ["by", "mode"],
      "properties": {
        "by": { "type": "string", "min_length": 1 },
        "mode": { "type": "string", "enum": ["lite", "heavy"] },
        "evidence": { "type": "object" }
      }
    },
    "audit_receipt_emitted": {
      "required": ["receipt_event", "attestor"],
      "properties": {
        "receipt_event": { "type": "string", "enum": ["completed", "validated"] },
        "attestor": { "type": "string", "min_length": 1 },
        "evidence": { "type": "object" },
        "anchor": {
          "type": "object",
          "required": ["commit", "semver"],
          "properties": {
            "commit": { "type": "string", "pattern": "^[a-f0-9]{7,40}$" },
            "tag": { "type": "string" },
            "semver": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" }
          }
        }
      }
    },
    "obpi_receipt_emitted": {
      "required": ["receipt_event", "attestor"],
      "properties": {
        "receipt_event": { "type": "string", "enum": ["completed", "validated"] },
        "attestor": { "type": "string", "min_length": 1 },
        "evidence": {
          "type": "object",
          "properties": {
            "value_narrative": { "type": "string", "min_length": 1 },
            "key_proof": { "type": "string", "min_length": 1 },
            "human_attestation": { "type": "boolean" },
            "attestation_text": { "type": "string", "min_length": 1 },
            "attestation_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
            "attestation_requirement": {
              "type": "string",
              "enum": ["required", "optional"]
            },
            "parent_adr": { "type": "string", "min_length": 1 },
            "parent_lane": { "type": "string", "enum": ["lite", "heavy"] },
            "scope_audit": {
              "type": "object",
              "properties": {
                "allowlist": {
                  "type": "array",
                  "items": { "type": "string", "min_length": 1 }
                },
                "changed_files": {
                  "type": "array",
                  "items": { "type": "string", "min_length": 1 }
                },
                "out_of_scope_files": {
                  "type": "array",
                  "items": { "type": "string", "min_length": 1 }
                }
              }
            },
            "git_sync_state": {
              "type": "object",
              "properties": {
                "branch": { "type": "string" },
                "remote": { "type": "string" },
                "head": { "type": "string" },
                "remote_head": { "type": "string" },
                "dirty": { "type": "boolean" },
                "ahead": { "type": "integer", "min": 0 },
                "behind": { "type": "integer", "min": 0 },
                "diverged": { "type": "boolean" },
                "actions": {
                  "type": "array",
                  "items": { "type": "string", "min_length": 1 }
                },
                "warnings": {
                  "type": "array",
                  "items": { "type": "string", "min_length": 1 }
                },
                "blockers": {
                  "type": "array",
                  "items": { "type": "string", "min_length": 1 }
                }
              }
            },
            "recorder_source": { "type": "string", "min_length": 1 },
            "recorder_warnings": {
              "type": "array",
              "items": { "type": "string", "min_length": 1 }
            },
            "req_proof_inputs": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name", "kind", "source", "status"],
                "properties": {
                  "name": { "type": "string", "min_length": 1 },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "command",
                      "artifact",
                      "brief_section",
                      "attestation",
                      "legacy_key_proof"
                    ]
                  },
                  "source": { "type": "string", "min_length": 1 },
                  "status": {
                    "type": "string",
                    "enum": ["present", "missing"]
                  },
                  "scope": { "type": "string", "min_length": 1 },
                  "gap_reason": { "type": "string", "min_length": 1 }
                }
              }
            }
          }
        },
        "obpi_completion": {
          "type": "string",
          "enum": ["completed", "attested_completed", "not_completed"]
        },
        "anchor": {
          "type": "object",
          "required": ["commit", "semver"],
          "properties": {
            "commit": { "type": "string", "pattern": "^[a-f0-9]{7,40}$" },
            "tag": { "type": "string" },
            "semver": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" }
          }
        }
      }
    },
    "artifact_renamed": {
      "required": ["new_id"],
      "properties": {
        "new_id": { "type": "string", "min_length": 1 },
        "reason": { "type": "string", "min_length": 1 }
      }
    },
    "adr_annotated": {
      "required": ["annotation"],
      "properties": {
        "annotation": { "type": "string", "min_length": 1 },
        "source_framework": { "type": "string", "min_length": 1 },
        "rationale": { "type": "string", "min_length": 1 }
      }
    },
    "lifecycle_transition": {
      "required": ["content_type", "from_state", "to_state"],
      "properties": {
        "content_type": { "type": "string", "min_length": 1 },
        "from_state": { "type": "string", "min_length": 1 },
        "to_state": { "type": "string", "min_length": 1 }
      }
    },
    "agent_sync_completed": {
      "required": ["updated_paths", "canonical_rule_count"],
      "properties": {
        "updated_paths": {
          "type": "array",
          "items": { "type": "string", "min_length": 1 }
        },
        "canonical_rule_count": { "type": "integer", "min": 0 }
      }
    },
    "adr_eval_completed": {
      "required": ["verdict", "adr_weighted_total", "obpi_count", "action_item_count"],
      "properties": {
        "verdict": { "type": "string", "min_length": 1 },
        "adr_weighted_total": { "type": "number" },
        "obpi_count": { "type": "integer", "min": 0 },
        "action_item_count": { "type": "integer", "min": 0 }
      }
    },
    "audit_generated": {
      "required": ["audit_file", "audit_plan_file", "passed"],
      "properties": {
        "audit_file": { "type": "string", "min_length": 1 },
        "audit_plan_file": { "type": "string", "min_length": 1 },
        "passed": { "type": "boolean" }
      }
    },
    "obpi_lock_claimed": {
      "required": ["agent", "ttl_minutes", "branch", "session_id"],
      "properties": {
        "agent": { "type": "string", "min_length": 1 },
        "ttl_minutes": { "type": "integer", "min": 0 },
        "branch": { "type": "string", "min_length": 1 },
        "session_id": { "type": "string", "min_length": 1 }
      }
    },
    "obpi_lock_released": {
      "required": ["agent"],
      "properties": {
        "agent": { "type": "string", "min_length": 1 },
        "force": { "type": "boolean" }
      }
    },
    "obpi_withdrawn": {
      "required": ["reason"],
      "properties": {
        "reason": { "type": "string", "min_length": 1 }
      }
    },
    "patch-release": {
      "required": ["version", "previous_version", "ghi_summary", "manifest_path"],
      "properties": {
        "version": { "type": "string", "min_length": 1 },
        "previous_version": { "type": "string", "min_length": 1 },
        "tag": {},
        "ghi_summary": { "type": "array" },
        "manifest_path": { "type": "string", "min_length": 1 }
      }
    },
    "task_started": {
      "required": ["task_id", "obpi_id", "adr_id", "agent"],
      "properties": {
        "task_id": { "type": "string", "min_length": 1 },
        "obpi_id": { "type": "string", "min_length": 1 },
        "adr_id": { "type": "string", "min_length": 1 },
        "agent": { "type": "string", "min_length": 1 }
      }
    },
    "task_completed": {
      "required": ["task_id", "obpi_id", "adr_id", "agent"],
      "properties": {
        "task_id": { "type": "string", "min_length": 1 },
        "obpi_id": { "type": "string", "min_length": 1 },
        "adr_id": { "type": "string", "min_length": 1 },
        "agent": { "type": "string", "min_length": 1 }
      }
    },
    "task_blocked": {
      "required": ["task_id", "obpi_id", "adr_id", "agent", "reason"],
      "properties": {
        "task_id": { "type": "string", "min_length": 1 },
        "obpi_id": { "type": "string", "min_length": 1 },
        "adr_id": { "type": "string", "min_length": 1 },
        "agent": { "type": "string", "min_length": 1 },
        "reason": { "type": "string", "min_length": 1 }
      }
    },
    "task_escalated": {
      "required": ["task_id", "obpi_id", "adr_id", "agent", "reason"],
      "properties": {
        "task_id": { "type": "string", "min_length": 1 },
        "obpi_id": { "type": "string", "min_length": 1 },
        "adr_id": { "type": "string", "min_length": 1 },
        "agent": { "type": "string", "min_length": 1 },
        "reason": { "type": "string", "min_length": 1 },
        "escalated_to": { "type": "string", "min_length": 1 }
      }
    }
  }
}
