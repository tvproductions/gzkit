          "type": [
            "string",
            "null"
          ],
          "enum": [
            "unchanged",
            "shrank",
            "grew",
            "changed"
          ]
        },
        "floor_moved_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "conditional": [
        {
          "when": {
            "field": "floor_direction",
            "in": [
              "shrank",
              "grew",
              "changed"
            ]
          },
          "then": {
            "required": [
              "attestor"
            ],
            "properties": {
              "attestor": {
                "type": "string",
                "min_length": 1
              }
            }
          },
          "because": "A retirement that moves invariant-tier liveness changes the 0-Kelvin floor every rendition must carry verbatim, and the runtime gate in `gz content retire` refuses one without a named --attestor (AGENTS.md \u00a7 Operator Doctrine, the ATTESTATION GRANULARITY FOR THE CONTENT SURFACE ruling: removing an entry is attested). A row recording the move with no witness contradicts the gate it is the Layer-2 witness for. The ledger is append-only -- do not edit the row; re-run `gz content retire <surface> --entry <id> --reason \"<why>\" --attestor \"<name>\"` so the event is emitted by the gate that enforces the condition. `floor_direction: \"unchanged\"` is a routine compressible retirement and needs no attestor."
        }
      ]
    },
