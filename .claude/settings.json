{
  "permissions": {
    "deny": [
      "Bash(git *--no-verify*)",
      "Bash(git *--no-verify)",
      "Bash(git *commit -n *)",
      "Bash(git *commit -n)",
      "Bash(git *hooksPath=*)",
      "Bash(git *config *hooksPath *)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(*.pem)",
      "Read(*.key)",
      "Read(*.p12)",
      "Read(*.pfx)",
      "Read(*.jks)",
      "Read(*.keystore)",
      "Read(id_rsa)",
      "Read(id_dsa)",
      "Read(id_ecdsa)",
      "Read(id_ed25519)",
      "Read(.netrc)",
      "Read(.credentials.json)",
      "Read(~/.ssh/id_*)",
      "Read(~/.aws/credentials)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.claude/.credentials.json)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(*.pem)",
      "Edit(*.key)",
      "Edit(*.p12)",
      "Edit(*.pfx)",
      "Edit(*.jks)",
      "Edit(*.keystore)",
      "Edit(id_rsa)",
      "Edit(id_dsa)",
      "Edit(id_ecdsa)",
      "Edit(id_ed25519)",
      "Edit(.netrc)",
      "Edit(.credentials.json)",
      "Edit(~/.ssh/id_*)",
      "Edit(~/.aws/credentials)",
      "Edit(~/.config/gcloud/**)",
      "Edit(~/.claude/.credentials.json)"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "uv run python \"$CLAUDE_PROJECT_DIR/scripts/session_orientation.py\""
          },
          {
            "type": "command",
            "command": "uv run python \"$CLAUDE_PROJECT_DIR/scripts/settings_local_backup.py\""
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "uv run python \"$CLAUDE_PROJECT_DIR/scripts/session_orientation.py\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "uv run python \"$CLAUDE_PROJECT_DIR/scripts/settings_local_backup.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "uv run python \"$CLAUDE_PROJECT_DIR/.claude/hooks/post-edit-ruff.py\""
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "gz-skills": {
      "source": {
        "source": "github",
        "repo": "tvproductions/gz-skills"
      }
    }
  },
  "enabledPlugins": {
    "gz-skills@gz-skills": true,
    "superpowers@claude-plugins-official": false
  }
}
