#!/bin/sh
# Auto-chain hook: the C/C/C ceiling as gate -> complexity advisor on failure (OBPI-0.0.29-05).
# Install: python -m gzkit.hooks.install_complexity_advisor
# Skip:    SKIP=complexity-advisor-auto-chain git commit

# Step 1: Run the ceiling gate (the complexity-ceiling entry this hook replaces;
# xenon held this step until RO-9 tranche 4 retired it, GHI #1183)
uv run gz validate --complexity-ceiling
GATE_EXIT=$?

if [ "$GATE_EXIT" -eq 0 ]; then
    exit 0
fi

# Step 2: The gate failed — collect staged Python files only (REQ-5)
STAGED=$(git diff --cached --name-only --diff-filter=d -- '*.py')
if [ -z "$STAGED" ]; then
    exit 0
fi

# Step 3: Delegate to Python runtime for timeout-wrapped advisor (REQ-4)
# shellcheck disable=SC2086
uv run python -m gzkit.hooks.install_complexity_advisor --run $STAGED
