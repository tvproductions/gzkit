{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --cache-dir \"$(git rev-parse --show-toplevel)/.gzkit/cache/uv\" python \"$(git rev-parse --show-toplevel)/scripts/session_orientation.py\"",
            "timeout": 30,
            "statusMessage": "Loading gzkit project orientation",
            "additionalContextLimit": 6000
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --project \"$(git rev-parse --show-toplevel)\" --cache-dir \"$(git rev-parse --show-toplevel)/.gzkit/cache/uv\" python -m gzkit.hooks.codex",
            "timeout": 10,
            "statusMessage": "Loading gzkit handoff advisement"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --project \"$(git rev-parse --show-toplevel)\" --cache-dir \"$(git rev-parse --show-toplevel)/.gzkit/cache/uv\" python -m gzkit.hooks.codex",
            "timeout": 10,
            "statusMessage": "Checking verification exit-code integrity"
          }
        ]
      }
    ]
  }
}
