{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "gzkit competitor radar monthly scan",
  "type": "object",
  "required": [
    "schema_version",
    "month",
    "scan_mode",
    "competitor_snapshots",
    "suggested_moves",
    "operator_decisions"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "month": { "type": "string" },
    "scan_mode": { "type": "string" },
    "competitor_snapshots": { "type": "array" },
    "suggested_moves": { "type": "array" },
    "operator_decisions": { "type": "array" },
    "discovered_candidates": { "type": "array" },
    "routed_follow_up": { "type": "array" }
  },
  "additionalProperties": true
}
